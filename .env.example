# Copy to .env and fill in for local development.
# docker-compose reads this file directly; services/api and services/transport-service
# fall back to this root file if they don't have their own .env.

# ---- Database ----
DATABASE_URL="postgresql://nearby:nearby_dev_password@localhost:5432/nearby?schema=public"
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby_dev_password
POSTGRES_DB=nearby

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Kafka ----
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="near-by-api"

# ---- Object storage (MinIO locally, S3 in production) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="nearby_minio"
S3_SECRET_ACCESS_KEY="nearby_minio_secret"
S3_BUCKET_MEDIA="nearby-media"
S3_BUCKET_VERIFICATION="nearby-verification-docs"
S3_FORCE_PATH_STYLE=true

# ---- Auth / JWT ----
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_REFRESH_TTL="7d"

# ---- Payments ----
# Leave the Razorpay keys empty to run with the built-in MockPaymentProvider.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Notifications (abstractions — no real provider wired locally) ----
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"

# ---- Services ----
API_PORT=4000
TRANSPORT_SERVICE_PORT=4100
TRANSPORT_SERVICE_URL="http://localhost:4100"
WEB_PORT=3000
CORS_ORIGIN="http://localhost:3000"

# ---- App ----
NODE_ENV=development
