{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@near-by/types$": "<rootDir>/../../../packages/types/src",
    "^@near-by/events$": "<rootDir>/../../../packages/events/src"
  }
}
